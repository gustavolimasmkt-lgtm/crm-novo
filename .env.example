# Banco (no Railway: referência ao serviço Postgres)
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
# Endereço público do app (usado nos links de convite)
APP_URL=http://localhost:3000
APP_NAME=CRM
# Link de primeiro acesso para criar o Master: /setup?token=<SETUP_TOKEN>. Remova depois de usar.
SETUP_TOKEN=
# E-mail transacional (opcional; sem isso os convites mostram o link para copiar)
RESEND_API_KEY=
EMAIL_FROM=
# Fase 1 em diante
REDIS_URL=
ANTHROPIC_API_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
